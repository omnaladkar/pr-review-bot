# GitHub token (repo scope)
GITHUB_TOKEN=ghp_xxx

# AI provider key (one of these depending on ai.provider)
OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENROUTER_API_KEY=sk-or-xxx

# For local: owner/repo/pr number
REPO_OWNER=your-org
REPO_NAME=your-repo
PR_NUMBER=42

# FREE local review (no API key): set AI provider to ollama instead
#   node dist/index.js run -o owner -r repo -p N --ollama
# One-time setup:  npm run setup:ollama

# Optional: JSON config overrides
# BOT_CONFIG={"checks":{"ai":{"enabled":true}}}